# ============================================================
# Environment files & secrets — NEVER commit
# ============================================================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
credentials.json
secrets.*
KMS

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
htmlcov/
build/
dist/

# ============================================================
# Virtual environments
# ============================================================
.venv/
venv/
env/
ENV/

# ============================================================
# Node / frontend (belt & suspenders — frontend/.gitignore also applies)
# ============================================================
node_modules/
.next/
out/
*.tsbuildinfo

# ============================================================
# Logs, temp files, local tool configuration
# ============================================================
*.log
logs/
tmp/
temp/
*.tmp
.cache/
# OpenCode local config (contains no secrets; re-add this line's file to track it)
opencode.json

# ============================================================
# OS / IDE
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ============================================================
# Generated browser artifacts (Playwright screenshots etc.)
# ============================================================
.screenshots/
playwright-report/
test-results/

# ============================================================
# Notebook checkpoints
# ============================================================
.ipynb_checkpoints/

# ============================================================
# ML / AI artifacts & datasets — large binaries stay local
# ============================================================
models/
model/
checkpoints/
runs/
wandb/
mlruns/
data/
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
*.bin
*.safetensors
*.h5
*.pkl
*.pickle
*.joblib
*.npz
*.npy
*.parquet
*.arrow

# ============================================================
# AI coding assistant local state (project docs like AGENTS.md,
# CLAUDE.md, .claude/skills/ stay tracked)
# ============================================================

# Claude Code
.claude/settings.local.json
.claude/worktrees/

# OpenAI Codex
.codex/config.local.toml

# Gemini CLI
.gemini/history/
.gemini/tmp/
.gemini/google_accounts.json
.gemini/installation_id
.gemini/oauth_creds.json

# Cursor
.cursor/chat/
.cursor/rules/*.local.mdc

# GitHub CLI
.github/personal-instructions.md
